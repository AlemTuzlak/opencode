{
  "name": "@tanstack/ai-openai",
  "version": "0.27.0",
  "description": "OpenAI adapter for TanStack AI chat, tools, images, video, speech, transcription, realtime, and structured outputs.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-openai"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./byok": {
      "types": "./dist/esm/byok.d.ts",
      "import": "./dist/esm/byok.js"
    },
    "./compatible": {
      "types": "./dist/esm/compatible/index.d.ts",
      "import": "./dist/esm/compatible/index.js"
    },
    "./siwc": {
      "types": "./dist/esm/siwc.d.ts",
      "import": "./dist/esm/siwc.js"
    },
    "./tools": {
      "types": "./dist/esm/tools/index.d.ts",
      "import": "./dist/esm/tools/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "ai",
    "ai-sdk",
    "typescript",
    "tanstack",
    "openai",
    "gpt",
    "adapter",
    "chat",
    "tool-calling",
    "structured-outputs",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "transcription",
    "realtime"
  ],
  "dependencies": {
    "@tanstack/ai-utils": "workspace:*",
    "@tanstack/openai-base": "workspace:*",
    "openai": "^7.30.0"
  },
  "peerDependencies": {
    "@tanstack/ai": "^0.65.1"
  }
}
